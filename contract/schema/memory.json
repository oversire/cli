{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oversire.dev/contract/memory.json",
  "title": "OverSire memory",
  "description": "Short, editable facts that AI jobs read. The user edits them. An entry that the AI proposes is a suggestion first.",
  "x-oversire-schema": 1,
  "$defs": {
    "MemoryScope": { "enum": ["user", "project", "subject"] },
    "MemoryDraft": {
      "description": "The proposal of a suggestion. On accept, the hub writes a MemoryEntry.",
      "type": "object",
      "properties": {
        "scope": { "$ref": "#/$defs/MemoryScope" },
        "scopeRef": { "description": "The project or the subject. Missing for scope user.", "$ref": "refs.json#/$defs/SubjectRef" },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "required": ["scope", "text"],
      "additionalProperties": false
    },
    "MemoryEntry": {
      "description": "Collection memory.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/MemoryScope" },
        "scopeRef": { "description": "The project or the subject. Missing for scope user.", "$ref": "refs.json#/$defs/SubjectRef" },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "source": { "description": "Who wrote the entry.", "enum": ["user", "suggestion"] },
        "suggestion": { "description": "The Suggestion id when the source is suggestion.", "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "scope", "text", "source", "updatedAt"],
      "additionalProperties": false
    }
  }
}
