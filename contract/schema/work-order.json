{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oversire.dev/contract/work-order.json",
  "title": "OverSire work orders",
  "description": "Typed orders from the hub to a runner device. There is no shell order. Dates are ISO 8601 UTC.",
  "x-oversire-schema": 1,
  "$defs": {
    "Date": { "type": "string", "format": "date-time" },
    "SessionOrder": {
      "description": "The op and its payload. A WorkOrder and a WorkOrderDraft hold these two fields at their top level.",
      "oneOf": [
        {
          "type": "object",
          "properties": { "op": { "const": "sessionStart" }, "payload": { "$ref": "actions.json#/$defs/LaunchRequest" } },
          "required": ["op", "payload"]
        },
        {
          "type": "object",
          "properties": { "op": { "const": "sessionStop" }, "payload": { "$ref": "#/$defs/SessionPayload" } },
          "required": ["op", "payload"]
        },
        {
          "type": "object",
          "properties": { "op": { "const": "sessionRead" }, "payload": { "$ref": "#/$defs/ReadPayload" } },
          "required": ["op", "payload"]
        },
        {
          "type": "object",
          "properties": { "op": { "const": "sessionSend" }, "payload": { "$ref": "#/$defs/SendPayload" } },
          "required": ["op", "payload"]
        },
        {
          "type": "object",
          "properties": { "op": { "const": "sessionHistory" }, "payload": { "$ref": "#/$defs/HistoryPayload" } },
          "required": ["op", "payload"]
        }
      ]
    },
    "SessionPayload": {
      "type": "object",
      "properties": { "session": { "$ref": "refs.json#/$defs/SessionRef" } },
      "required": ["session"],
      "additionalProperties": false
    },
    "ReadPayload": {
      "type": "object",
      "properties": {
        "session": { "$ref": "refs.json#/$defs/SessionRef" },
        "lines": { "description": "The number of last lines. The runner caps it.", "type": "integer", "minimum": 1 }
      },
      "required": ["session", "lines"],
      "additionalProperties": false
    },
    "HistoryPayload": {
      "description": "Read the history of a session as a SessionDigest. A runner that does not know the op fails the order.",
      "type": "object",
      "properties": {
        "session": { "$ref": "refs.json#/$defs/SessionRef" },
        "budget": { "$ref": "session-digest.json#/$defs/HistoryBudget" }
      },
      "required": ["session"],
      "additionalProperties": false
    },
    "SendPayload": {
      "type": "object",
      "properties": {
        "session": { "$ref": "refs.json#/$defs/SessionRef" },
        "text": { "description": "A user message. Empty with a permission answer or a question answer.", "type": "string" },
        "permission": { "$ref": "#/$defs/PermissionAnswer" },
        "answer": { "$ref": "#/$defs/RunnerAnswer" }
      },
      "required": ["session", "text"],
      "additionalProperties": false
    },
    "PermissionAnswer": {
      "description": "The answer to the PermissionPrompt of a session.",
      "type": "object",
      "properties": {
        "id": { "description": "The PermissionPrompt id.", "type": "string", "minLength": 1 },
        "allow": { "type": "boolean" }
      },
      "required": ["id", "allow"],
      "additionalProperties": false
    },
    "PermissionPrompt": {
      "description": "An agent asks for a permission. No answer before expiresAt is a deny.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tool": { "description": "The tool or the kind of the request, for example Bash or edit.", "type": "string" },
        "text": { "description": "A short summary of the request.", "type": "string", "maxLength": 500 },
        "expiresAt": { "$ref": "#/$defs/Date" }
      },
      "required": ["id", "tool", "text", "expiresAt"],
      "additionalProperties": false
    },
    "RunnerQuestion": {
      "description": "An agent asks the user one or more questions and waits. The id is the pending request id of the runner.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "round": { "description": "1 for the first round of questions.", "type": "integer", "minimum": 1 },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/RunnerQuestionItem" } },
        "askedAt": { "$ref": "#/$defs/Date" }
      },
      "required": ["id", "round", "items", "askedAt"],
      "additionalProperties": false
    },
    "RunnerQuestionItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "header": { "description": "A short label, for example Schema read.", "type": "string" },
        "text": { "type": "string", "maxLength": 2000 },
        "why": { "description": "Why the agent asks.", "type": "string" },
        "kind": { "enum": ["single", "multi", "free"] },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "label": { "type": "string", "minLength": 1 }, "detail": { "type": "string" } },
            "required": ["label"],
            "additionalProperties": false
          }
        },
        "allowsOther": { "description": "A free text next to the options.", "type": "boolean" }
      },
      "required": ["id", "text", "kind", "options", "allowsOther"],
      "additionalProperties": false
    },
    "RunnerAnswer": {
      "description": "The answer to the RunnerQuestion of a session.",
      "type": "object",
      "properties": {
        "id": { "description": "The RunnerQuestion id.", "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "choices": { "description": "The chosen option labels.", "type": "array", "items": { "type": "string" } },
              "other": { "description": "The free text.", "type": "string" }
            },
            "required": ["id", "choices"],
            "additionalProperties": false
          }
        },
        "note": { "type": "string" }
      },
      "required": ["id", "items"],
      "additionalProperties": false
    },
    "RunnerSessionState": { "enum": ["queued", "starting", "working", "waitingInput", "waitingPermission", "done", "failed"] },
    "RunnerSession": {
      "description": "Collection runner-sessions: a session of the oversire runtime on a runner (id = session.id). Only the hub writes it, from the session messages of the runner. The full transcript stays on the runner.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "runner": { "description": "The runner device id.", "type": "string", "minLength": 1 },
        "session": { "$ref": "refs.json#/$defs/SessionRef" },
        "order": { "description": "The sessionStart order.", "type": "string", "minLength": 1 },
        "agent": { "description": "The harness, for example claude.", "type": "string" },
        "repo": { "type": "string" },
        "branch": { "type": "string" },
        "item": { "$ref": "refs.json#/$defs/ItemRef" },
        "state": { "$ref": "#/$defs/RunnerSessionState" },
        "summary": { "description": "The last short summary of the transcript.", "type": "string", "maxLength": 500 },
        "permission": { "$ref": "#/$defs/PermissionPrompt" },
        "question": { "$ref": "#/$defs/RunnerQuestion" },
        "error": { "type": "string" },
        "startedAt": { "$ref": "#/$defs/Date" },
        "updatedAt": { "$ref": "#/$defs/Date" }
      },
      "required": ["id", "runner", "session", "order", "agent", "repo", "state", "startedAt", "updatedAt"],
      "additionalProperties": false
    },
    "WorkOrderDraft": {
      "description": "The proposal of a suggestion. On accept, the hub makes a WorkOrder from it.",
      "type": "object",
      "properties": {
        "runtime": { "description": "The AgentRuntime provider id, for example orca or oversire.", "$ref": "refs.json#/$defs/ProviderID" },
        "runner": { "description": "The runner device. Missing: the hub picks a runner with the runtime.", "type": "string" },
        "op": { "enum": ["sessionStart", "sessionStop", "sessionRead", "sessionSend", "sessionHistory"] },
        "payload": { "type": "object" }
      },
      "allOf": [{ "$ref": "#/$defs/SessionOrder" }],
      "required": ["runtime", "op", "payload"],
      "additionalProperties": false
    },
    "WorkOrderState": {
      "description": "held: the hub keeps a sessionStart order while its item has an open blocker or a busy area. The hub never sends a held order to a runner. A reader that does not know a state keeps it as it is.",
      "enum": ["held", "queued", "sent", "acked", "done", "failed", "expired"]
    },
    "WorkOrderHold": {
      "description": "Why the hub holds the order.",
      "type": "object",
      "properties": {
        "blockers": { "description": "The open items that block the item of the order.", "type": "array", "items": { "$ref": "refs.json#/$defs/ItemRef" } },
        "areas": { "description": "The areas of the item that an other session holds.", "type": "array", "items": { "$ref": "suggestion.json#/$defs/Area" } },
        "since": { "$ref": "#/$defs/Date" }
      },
      "required": ["blockers", "areas", "since"],
      "additionalProperties": false
    },
    "WorkOrderResult": {
      "type": "object",
      "properties": {
        "session": { "description": "The session that sessionStart made.", "$ref": "refs.json#/$defs/SessionRef" },
        "lines": { "description": "The lines that sessionRead read.", "type": "array", "items": { "type": "string" } },
        "digest": { "description": "The digest that sessionHistory read.", "$ref": "session-digest.json#/$defs/SessionDigest" },
        "error": { "description": "Why the order failed.", "type": "string" }
      },
      "additionalProperties": false
    },
    "WorkOrder": {
      "description": "Collection work-orders.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "runner": { "description": "The runner device id.", "type": "string", "minLength": 1 },
        "runtime": { "description": "The AgentRuntime provider id, for example orca or oversire.", "$ref": "refs.json#/$defs/ProviderID" },
        "op": { "enum": ["sessionStart", "sessionStop", "sessionRead", "sessionSend", "sessionHistory"] },
        "payload": { "type": "object" },
        "suggestion": { "description": "The accepted Suggestion id.", "type": "string", "minLength": 1 },
        "createdAt": { "$ref": "#/$defs/Date" },
        "expiresAt": { "$ref": "#/$defs/Date" },
        "state": { "$ref": "#/$defs/WorkOrderState" },
        "hold": { "description": "Set while the state is held.", "$ref": "#/$defs/WorkOrderHold" },
        "result": { "$ref": "#/$defs/WorkOrderResult" }
      },
      "allOf": [{ "$ref": "#/$defs/SessionOrder" }],
      "required": ["id", "runner", "runtime", "op", "payload", "suggestion", "createdAt", "expiresAt", "state"],
      "additionalProperties": false
    }
  }
}
