{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oversire.dev/contract/actions.json",
  "title": "OverSire actions",
  "description": "Typed writes that the app or the cloud sends to an adapter.",
  "x-oversire-schema": 1,
  "$defs": {
    "ActionKind": {
      "description": "The risk of an action in the action catalog. read: allow. change: ask once in each chat. outward: ask each time. settings: the assistant never runs it.",
      "enum": ["read", "change", "outward", "settings"]
    },
    "ItemPatch": {
      "description": "A write to a tracker item. A missing field stays as it is.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "status": { "description": "Status option id.", "type": "string" },
        "priority": { "description": "Priority option id.", "type": "string" },
        "assignees": { "description": "Person ids.", "type": "array", "items": { "type": "string" } },
        "labels": { "description": "Label ids.", "type": "array", "items": { "type": "string" } },
        "parent": { "description": "Item id.", "type": "string" },
        "bodyMarkdown": { "type": "string" }
      },
      "additionalProperties": false
    },
    "MergeMethod": { "enum": ["merge", "rebase", "squash"] },
    "ChangeAction": {
      "oneOf": [
        { "type": "object", "properties": { "type": { "const": "approve" }, "body": { "type": "string" } }, "required": ["type"], "additionalProperties": false },
        { "type": "object", "properties": { "type": { "const": "request-changes" }, "body": { "type": "string" } }, "required": ["type", "body"], "additionalProperties": false },
        { "type": "object", "properties": { "type": { "const": "comment" }, "body": { "type": "string" } }, "required": ["type", "body"], "additionalProperties": false },
        { "type": "object", "properties": { "type": { "const": "merge" }, "method": { "$ref": "#/$defs/MergeMethod" } }, "required": ["type", "method"], "additionalProperties": false },
        { "type": "object", "properties": { "type": { "const": "close" } }, "required": ["type"], "additionalProperties": false }
      ]
    },
    "RunAction": { "enum": ["rerun", "rerunFailed", "cancel"] },
    "LaunchRequest": {
      "description": "Start an agent in a runtime workspace.",
      "type": "object",
      "properties": {
        "repo": { "description": "Repo path or remote URL in the runtime.", "type": "string" },
        "item": { "$ref": "refs.json#/$defs/ItemRef" },
        "name": { "description": "The workspace name. Default: the item key.", "type": "string" },
        "note": { "description": "The workspace note. Default: the item URL.", "type": "string" },
        "branch": { "type": "string" },
        "agent": { "description": "Same raw values as the AgentBinder Harness: claude, codex, opencode, cursor.", "type": "string" },
        "prompt": { "type": "string" },
        "environment": { "description": "Runtime environment id.", "type": "string" },
        "command": { "description": "The resolved shell command that starts the agent in a terminal runtime. Empty: the runtime default. The first word is the agent program.", "type": "string" }
      },
      "required": ["repo", "agent", "prompt"],
      "additionalProperties": false
    },
    "RelationKind": {
      "description": "The kind of a relation, seen from the item that holds it. A blocks B is the same relation as B blockedBy A. The tracker keeps the relations: OverSire keeps no second graph. Duplicates are not a relation here: the intake verdict covers them.",
      "enum": ["blockedBy", "blocks", "relatesTo"]
    },
    "ItemRelation": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/RelationKind" },
        "item": { "description": "The other item.", "$ref": "refs.json#/$defs/ItemRef" }
      },
      "required": ["kind", "item"],
      "additionalProperties": false
    },
    "RelationPatch": {
      "description": "A write to the relations of one item. The adapter adds before it removes.",
      "type": "object",
      "properties": {
        "add": { "type": "array", "items": { "$ref": "#/$defs/ItemRelation" } },
        "remove": { "type": "array", "items": { "$ref": "#/$defs/ItemRelation" } }
      },
      "required": ["add", "remove"],
      "additionalProperties": false
    }
  }
}
