              "type": "string"
            },
            "maxItems": 6
          }
        },
        "additionalProperties": false,
        "required": [
          "kind"
        ]
      }
    },
    {
      "kind": "sweep.applied",
      "domain": "agent",
      "actorTypes": [
        "agent"
      ],
      "private": false,
