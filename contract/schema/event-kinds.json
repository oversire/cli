{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oversire.dev/contract/event-kinds.json",
  "title": "OverSire event kinds",
  "description": "The catalog of the kinds of event.json. Each entry: kind, domain, the actor types that may write it, private (the summary holds prompt text), the summary rule, and the payload as a small JSON Schema. Each kind has the fixture fixtures/event/<kind>.json. A new kind goes here first, with its fixture. A reader keeps a row of a kind that it does not know.",
  "x-oversire-schema": 1,
  "domains": [
    "agent",
    "human",
    "git",
    "ci",
    "codehost",
    "tracker",
    "system"
  ],
  "kinds": [
    {
      "kind": "session.started",
      "domain": "agent",
      "actorTypes": [
        "agent"
      ],
      "private": false,
      "summary": "harness and model, and the place",
      "payload": {
        "type": "object",
        "properties": {
          "harness": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "runtime": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "envKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "harness"
        ]
      }
    },
    {
      "kind": "session.ended",
      "domain": "agent",
      "actorTypes": [
        "agent",
        "human",
        "system"
      ],
      "private": false,
      "summary": "the reason and the length",
      "payload": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          },
          "turns": {
            "type": "integer",
            "minimum": 0
          },
          "durationSec": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    {
      "kind": "turn.started",
      "domain": "agent",
      "actorTypes": [
        "agent"
      ],
      "private": false,
      "summary": "turn N, task or steer",
      "payload": {
        "type": "object",
        "properties": {
          "turn": {
            "type": "integer",
            "minimum": 0
          },
          "steer": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "turn"
        ]
      }
    },
    {
      "kind": "turn.ended",
      "domain": "agent",
      "actorTypes": [
        "agent"
      ],
      "private": false,
      "summary": "the counts of the turn",
      "payload": {
        "type": "object",
        "properties": {
          "turn": {
            "type": "integer",
            "minimum": 0
          },
          "tools": {
            "type": "integer",
            "minimum": 0
          },
          "toolErrors": {
            "type": "integer",
            "minimum": 0
          },
          "filesEdited": {
            "type": "integer",
            "minimum": 0
          },
          "testsRun": {
            "type": "integer",
            "minimum": 0
          },
          "testsFailed": {
            "type": "integer",
            "minimum": 0
          },
          "interrupted": {
            "type": "boolean"
          },
          "durationSec": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "turn",
          "tools"
        ]
      }
    },
    {
      "kind": "turn.interrupted",
      "domain": "agent",
      "actorTypes": [
        "human"
      ],
      "private": false,
      "summary": "you stopped the agent",
      "payload": {
        "type": "object",
        "properties": {
          "turn": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "turn"
        ]
      }
    },
    {
      "kind": "wait.started",
      "domain": "agent",
      "actorTypes": [
        "agent",
        "system"
      ],
      "private": false,
      "summary": "what the agent waits for",
      "payload": {
        "type": "object",
        "properties": {
          "reason": {
            "enum": [
              "question",
              "permission",
              "plan",
              "review",
              "input"
